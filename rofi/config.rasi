configuration {
    modes: "Favorites:~/.config/rofi/favorites.sh,drun,Power:~/.config/rofi/power.sh";
    display-Favorites: "Favorites";
    display-drun: "Apps";
    display-Power: "Power";
    sidebar-mode: true;
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
}

* {
    bg:           #1a1b26;
    bg-alt:       #24283b;
    bg-selected:  #283457;
    fg:           #c0caf5;
    fg-muted:     #565f89;
    blue:         #7aa2f7;
    cyan:         #7dcfff;
    red:          #f7768e;

    font: "JetBrainsMono Nerd Font 11";

    background-color: transparent;
    text-color:       @fg;

    margin:  0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width:            640px;
    background-color: @bg;
    border:           2px;
    border-color:     @blue;
    border-radius:    0px;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview, mode-switcher ];
    spacing:  12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    0px;
    padding:          8px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt {
    text-color: @blue;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "Type to search...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    lines:     8;
    columns:   1;
    spacing:   4px;
    cycle:     true;
    dynamic:   true;
    scrollbar: false;
}

element {
    padding:       8px 12px;
    border-radius: 0px;
    spacing:       12px;
    children:      [ element-icon, element-text ];
}

element-icon {
    size: 24px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @cyan;
}

element selected.urgent {
    background-color: @red;
    text-color:       @bg;
}

mode-switcher {
    spacing: 8px;
    padding: 4px 0px 0px 0px;
}

button {
    padding:          8px 14px;
    background-color: @bg-alt;
    text-color:       @fg-muted;
    border-radius:    0px;
    cursor:           pointer;
}

button selected {
    background-color: @blue;
    text-color:       @bg;
    font:             "JetBrainsMono Nerd Font Bold 11";
}
