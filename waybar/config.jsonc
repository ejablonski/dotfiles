{
    "layer": "top",
    "position": "top",
    "height": 30, 
    "spacing": 4,
    "reload_style_on_change": true,

    // Left, center, and right alignments translated from Polybar
    "modules-left": ["sway/workspaces"],
    "modules-center": ["custom/timewarrior"],
    "modules-right": [
        "cpu", 
        "memory", 
        "pulseaudio", 
        "bluetooth", 
        "network", 
        "battery#bat0", 
        "battery#bat1", 
        "clock"
    ],

    // =========================================================================
    // Modules Definition
    // =========================================================================

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "custom/timewarrior": {
        "exec": "~/.config/waybar/timewarrior.sh",
        "interval": 5,
        "signal": 8,
        "on-click": "timew stop && pkill -RTMIN+8 waybar",
        "on-click-right": "timew continue && pkill -RTMIN+8 waybar",
        "format": "{}"
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "󰘚 {used:0.1f}G ({percentage}%)"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-disabled": "Bluetooth: Disabled",
        "tooltip-format-off": "Bluetooth: Off",
        "tooltip-format-connected": "{num_connections} connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "󰂱 {device_alias}",
        "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
        "on-click": "sh -c 'bluetoothctl power $([ \"$(bluetoothctl show 2>/dev/null | grep -o \"Powered: yes\")\" = \"Powered: yes\" ] && echo \"off\" || echo \"on\")'"
    },

    "network": {
        "interval": 3,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 (No IP)",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nFrequency: {frequency}GHz",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    // Dual battery translation (BAT0 and BAT1)
    "battery": {
        "interval": 2,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{capacity}%",
        "tooltip-format-charging": "{capacity}% (Charging: {timeTo})",
        "tooltip-format-discharging": "{capacity}% (Discharging: {timeTo})",
        "tooltip-format-full": "{capacity}% (Full)"
    },

    "battery#bat0": {
        "bat": "BAT0",
        "interval": 2,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "BAT0 (Internal): {capacity}%",
        "tooltip-format-charging": "BAT0 (Internal): {capacity}% (Charging: {timeTo})",
        "tooltip-format-discharging": "BAT0 (Internal): {capacity}% (Discharging: {timeTo})",
        "tooltip-format-full": "BAT0 (Internal): {capacity}% (Full)"
    },

    "battery#bat1": {
        "bat": "BAT1",
        "interval": 2,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "BAT1 (External): {capacity}%",
        "tooltip-format-charging": "BAT1 (External): {capacity}% (Charging: {timeTo})",
        "tooltip-format-discharging": "BAT1 (External): {capacity}% (Discharging: {timeTo})",
        "tooltip-format-full": "BAT1 (External): {capacity}% (Full)"
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%I:%M %p  %b %d}"
    }
}
