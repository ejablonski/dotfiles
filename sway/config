# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu rofi -show Favorites

# Font for window titles
font pango:JetBrainsMono Nerd Font 10

### Output configuration
# Primary Laptop Display (placed at origin 0,0)
output eDP-1 pos 0 0

# Secondary 100Hz Monitor (Samsung LS24C33xG placed to the right at 1920,0)
output "Samsung Electric Company LS24C33xG H9TXA00978" mode 1920x1080@100Hz pos 1920 0
output DP-3 mode 1920x1080@100Hz pos 1920 0
output HDMI-A-1 mode 1920x1080@100Hz pos 1920 0
output DP-1 mode 1920x1080@100Hz pos 1920 0
output DP-2 mode 1920x1080@100Hz pos 1920 0

### Idle configuration
exec swayidle -w \
         timeout 300 '~/.config/sway/lock.sh' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep '~/.config/sway/lock.sh'

### Input configuration
#
    input type:touchpad {
        dwt enabled
        tap enabled
        natural_scroll enabled
        middle_emulation enabled
    }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

    # Lock screen
    bindsym $mod+Mod1+l exec ~/.config/sway/lock.sh
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# ==============================================================================
# Swaysome: Independent Workspaces per Monitor (AwesomeWM-style)
# ==============================================================================
# Initialize workspace groups for all connected outputs
exec_always --no-startup-id swaysome init 1

# Workspaces:
#
    # Switch to workspace (1-10) on the currently focused screen
    bindsym $mod+1 exec swaysome focus 1
    bindsym $mod+2 exec swaysome focus 2
    bindsym $mod+3 exec swaysome focus 3
    bindsym $mod+4 exec swaysome focus 4
    bindsym $mod+5 exec swaysome focus 5
    bindsym $mod+6 exec swaysome focus 6
    bindsym $mod+7 exec swaysome focus 7
    bindsym $mod+8 exec swaysome focus 8
    bindsym $mod+9 exec swaysome focus 9
    bindsym $mod+0 exec swaysome focus 0

    # Move focused window to workspace (1-10) on the currently focused screen
    bindsym $mod+Shift+1 exec swaysome move 1
    bindsym $mod+Shift+2 exec swaysome move 2
    bindsym $mod+Shift+3 exec swaysome move 3
    bindsym $mod+Shift+4 exec swaysome move 4
    bindsym $mod+Shift+5 exec swaysome move 5
    bindsym $mod+Shift+6 exec swaysome move 6
    bindsym $mod+Shift+7 exec swaysome move 7
    bindsym $mod+Shift+8 exec swaysome move 8
    bindsym $mod+Shift+9 exec swaysome move 9
    bindsym $mod+Shift+0 exec swaysome move 0

    # Move focused window to next / previous screen
    bindsym $mod+o exec swaysome next-output
    bindsym $mod+Shift+o exec swaysome prev-output
    bindsym $mod+m exec swaysome next-output
    bindsym $mod+Shift+m exec swaysome prev-output

    # Focus specific screen / workspace group (1, 2, 3...)
    bindsym $mod+Mod1+1 exec swaysome focus-group 1
    bindsym $mod+Mod1+2 exec swaysome focus-group 2
    bindsym $mod+Mod1+3 exec swaysome focus-group 3

    # Move focused window to the same workspace index on another screen
    bindsym $mod+Mod1+Shift+1 exec swaysome move-to-group 1
    bindsym $mod+Mod1+Shift+2 exec swaysome move-to-group 2
    bindsym $mod+Mod1+Shift+3 exec swaysome move-to-group 3

    # Move the entire active workspace group to the next / previous screen
    bindsym $mod+Ctrl+o exec swaysome workspace-group-next-output
    bindsym $mod+Ctrl+Shift+o exec swaysome workspace-group-prev-output
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+Shift+b splith
    bindsym $mod+Shift+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # Special key to take a screenshot with grim
    bindsym Print exec grim

# ==============================================================================
# Status Bar & Bar Configuration
# ==============================================================================
bar {
    swaybar_command waybar
}

# ==============================================================================
# Window Borders & Visual Styles
# ==============================================================================
# 1. Turn off title bars for regular splits but enable a clean 1-pixel outline border
default_border pixel 1
default_floating_border pixel 1

# 2. Apply this outline style globally to all native and legacy apps
for_window [app_id=".*"] border pixel 1
for_window [class=".*"] border pixel 1
for_window [shell="xwayland"] border pixel 1

# 3. Application Icons in Tab & Window Titles
# Default Kitty terminal icon (shell prompt)
for_window [app_id="kitty"]                            title_format "󰞷  %title"

# CLI applications inside Kitty (detected via running command title)
for_window [app_id="kitty" title="(?i).*(nvim|vim).*"] title_format "  %title"
for_window [app_id="kitty" title="(?i).*lazygit.*"]    title_format "󰊢  %title"
for_window [app_id="kitty" title="(?i).*yazi.*"]       title_format "󰇥  %title"
for_window [app_id="kitty" title="(?i).*timew.*"]      title_format "󱎫  %title"
for_window [app_id="kitty" title="(?i).*agy.*"]        title_format "󰚩  %title"

# GUI Applications
for_window [app_id="org.pwmt.zathura"]                 title_format "  %title"
for_window [app_id="google-chrome"]                    title_format "  %title"
for_window [class="(?i)google-chrome"]                 title_format "  %title"
for_window [app_id="(?i)steam"]                        title_format "󰓓  %title"
for_window [class="(?i)steam"]                         title_format "󰓓  %title"
for_window [app_id="(?i)kicad"]                        title_format "󱘖  %title"
for_window [class="(?i)kicad"]                         title_format "󱘖  %title"

# 4. Tabbed & Stacked Titlebar Styling (Compact & Centered)
title_align center
titlebar_border_thickness 1
titlebar_padding 8 2

# 5. Custom Focus & Tab Colors with Transparency (Tokyo Night #RRGGBBAA)
# Structure:            class                   border    bg          text      indicator child_border
client.focused          #7aa2f7 #283457d0 #c0caf5   #7dcfff   #7aa2f7
client.focused_inactive #24283b #1f2335b0 #737aa2   #24283b   #24283b
client.unfocused        #1a1b26 #16161eb0 #565f89   #1a1b26   #1a1b26
client.urgent           #f7768e #f7768ecc #1a1b26   #f7768e   #f7768e

# 6. Explicit Gap spacing
gaps inner 10
gaps outer 10

# ==============================================================================
# Startup Applications & Daemons
# ==============================================================================
# Import environment variables into systemd and D-Bus user session
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Start XFCE settings daemon to apply GTK theme, font, cursor, and icons
exec_always xfsettingsd --sm-client-disable

# Use exec_always so your background re-renders instantly on any config reload
exec_always swaybg -i ~/Pictures/wp_01.png -m fill

# Start cliphist history tracking listeners
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

